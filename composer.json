{
    "name": "mj-zana/communication",
    "description": "Email for Zana applications: messages, configured senders, Symfony Mailer transports and a recorder for tests",
    "type": "library",
    "keywords": ["zana", "mail", "email", "mailer", "smtp"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.1",
        "symfony/mailer": "^7.4 || ^8.0"
    },
    "require-dev": {
        "mj-zana/database": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "mj-zana/database": "To keep newsletter subscribers in the application's database"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Communication\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Communication\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.3.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.3.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.3.0" } } },
        { "type": "path", "url": "../zana-database", "options": { "symlink": true, "versions": { "mj-zana/database": "2.3.0" } } },
        { "type": "path", "url": "../zana-ddd", "options": { "symlink": true, "versions": { "mj-zana/ddd": "2.3.0" } } },
        { "type": "path", "url": "../zana-console", "options": { "symlink": true, "versions": { "mj-zana/console": "2.3.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
